#!/usr/bin/python3
"""Display settings that last, and a readable default on dense screens.

labwc starts every screen at scale 1 and remembers nothing. The "Displays"
window (wdisplays) changes scale, resolution, position and rotation, but
only until the session ends. This helper fills both gaps:

- A set of screens seen for the first time gets a default: scale 2 on a
  screen of 192 dots per inch or more that is at least 1200 pixels high
  (the rule GNOME uses), otherwise nothing is changed.
- Whatever layout then stays in place for ten seconds is saved, per set of
  connected screens, and applied again at the next login or when the same
  screens are connected again.

    mate-wayland-desktop-displays --init   apply once and exit (run before
                                           the panel starts)
    mate-wayland-desktop-displays          keep watching and saving

Saved layouts: ~/.config/mate-wayland-desktop/displays.json. Delete that
file to return to the defaults.

Does nothing when the user has their own kanshi configuration
(~/.config/kanshi/config), which the session then uses instead, and nothing
in a virtual machine, where the size follows the VM window.
"""
import json
import os
import subprocess
import sys

CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
STORE = os.path.join(CONFIG, "mate-wayland-desktop", "displays.json")
SETTLE_SECONDS = 10


def log(*words):
    print(*words, flush=True)


def stand_aside():
    if os.path.exists(os.path.join(CONFIG, "kanshi", "config")):
        return "the user has a kanshi configuration"
    if subprocess.call(["systemd-detect-virt", "--quiet", "--vm"]) == 0:
        return "this is a virtual machine"
    return None


def outputs():
    """Connected screens, as wlr-randr reports them."""
    try:
        text = subprocess.run(["wlr-randr", "--json"], capture_output=True,
                              text=True, check=True).stdout
        return json.loads(text)
    except (OSError, subprocess.CalledProcessError, ValueError) as err:
        log("cannot read the screens:", err)
        return []


def identities(outs):
    """What a saved layout recognises each screen by, as {connector: name}.

    A monitor that reports a serial number is recognised by make, model and
    serial, so it is found again on another port or dock. Without a serial
    it is the connector it is plugged into. Two monitors of the same model
    can report the same serial; those are told apart by connector as well.
    """
    found = {}
    for out in outs:
        if out.get("serial"):
            found[out["name"]] = "%s %s %s" % (
                out.get("make"), out.get("model"), out["serial"])
        else:
            found[out["name"]] = out["name"]
    names = list(found.values())
    for connector, name in found.items():
        if names.count(name) > 1:
            found[connector] = "%s on %s" % (name, connector)
    return found


def layout_key(outs):
    return " + ".join(sorted(identities(outs).values()))


def settings(out):
    """The settings of one screen that are saved and restored."""
    if not out.get("enabled"):
        return {"enabled": False}
    found = {
        "enabled": True,
        "scale": round(out.get("scale", 1.0), 4),
        "transform": out.get("transform", "normal"),
        "position": [out["position"]["x"], out["position"]["y"]],
    }
    for mode in out.get("modes", []):
        if mode.get("current"):
            found["mode"] = "%dx%d@%fHz" % (mode["width"], mode["height"],
                                           mode["refresh"])
    return found


def current_layout(outs):
    names = identities(outs)
    return {names[o["name"]]: settings(o) for o in outs}


def load_store():
    try:
        with open(STORE) as store:
            return json.load(store)
    except (OSError, ValueError):
        return {}


def save_store(saved):
    os.makedirs(os.path.dirname(STORE), exist_ok=True)
    with open(STORE + ".new", "w") as store:
        json.dump(saved, store, indent=2, sort_keys=True)
        store.write("\n")
    os.replace(STORE + ".new", STORE)


def is_dense(out):
    """GNOME's rule for a screen that needs scale 2."""
    size = out.get("physical_size") or {}
    width_mm = size.get("width", 0)
    mode = next((m for m in out.get("modes", []) if m.get("current")), None)
    # Some screens report their aspect ratio (16 x 9) instead of a size.
    if not mode or width_mm < 100:
        return False
    dpi = mode["width"] / (width_mm / 25.4)
    return dpi >= 192 and mode["height"] >= 1200


def apply(outs, wanted):
    """Apply a saved layout, or the default when there is none."""
    args = []
    names = identities(outs)
    for out in outs:
        have = settings(out)
        want = wanted.get(names[out["name"]]) if wanted else None
        if want is None:
            if (not wanted and have["enabled"] and have["scale"] == 1
                    and is_dense(out)):
                log(out["name"], "is a dense screen: scale 2")
                args += ["--output", out["name"], "--scale", "2"]
            continue
        if want == have:
            continue
        args += ["--output", out["name"]]
        if not want["enabled"]:
            args += ["--off"]
            continue
        args += ["--on"]
        if "mode" in want:
            args += ["--mode", want["mode"]]
        args += ["--pos", "%d,%d" % tuple(want["position"]),
                 "--scale", str(want["scale"]),
                 "--transform", want["transform"]]
    if args:
        log("wlr-randr", " ".join(args))
        subprocess.call(["wlr-randr"] + args)


def apply_for_current_screens():
    outs = outputs()
    if outs:
        apply(outs, load_store().get(layout_key(outs)))
    return layout_key(outs)


def watch():
    import gi
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    state = {"key": layout_key(outputs()), "candidate": None, "timer": 0}

    def check():
        state["timer"] = 0
        outs = outputs()
        if not outs:
            return False
        key = layout_key(outs)
        if key != state["key"]:
            # Screens were added or removed.
            state["key"] = key
            state["candidate"] = None
            apply(outs, load_store().get(key))
            schedule(1)
            return False
        layout = current_layout(outs)
        saved = load_store()
        if saved.get(key) == layout:
            state["candidate"] = None
        elif state["candidate"] == layout:
            # Unchanged since the last look, ten seconds ago: keep it.
            saved[key] = layout
            save_store(saved)
            state["candidate"] = None
            log("saved the layout for:", key)
        else:
            state["candidate"] = layout
            schedule(SETTLE_SECONDS)
        return False

    def schedule(seconds):
        if state["timer"]:
            GLib.source_remove(state["timer"])
        state["timer"] = GLib.timeout_add_seconds(seconds, check)

    def on_change(*_args):
        schedule(1)

    def follow(monitor):
        monitor.connect("invalidate", on_change)
        monitor.connect("notify", on_change)

    def on_added(_display, monitor):
        follow(monitor)
        on_change()

    display = Gdk.Display.get_default()
    display.connect("monitor-added", on_added)
    display.connect("monitor-removed", on_change)
    for number in range(display.get_n_monitors()):
        follow(display.get_monitor(number))

    # A change that moves no pixels on any screen (a screen turned upside
    # down) sends no event; look once a minute as well.
    def slow_look():
        if not state["timer"]:
            schedule(1)
        return True

    GLib.timeout_add_seconds(60, slow_look)
    schedule(1)
    Gtk.main()


def main():
    reason = stand_aside()
    if reason:
        log("doing nothing:", reason)
        return 0
    if "--init" in sys.argv[1:]:
        apply_for_current_screens()
        return 0
    watch()
    return 0


if __name__ == "__main__":
    sys.exit(main())
