<?xml version="1.0"?>
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>4</cornerRadius>
    <font place="ActiveWindow" name="Noto Sans" size="10" weight="bold"/>
    <font place="InactiveWindow" name="Noto Sans" size="10"/>
    <!-- GNOME 2 button order: icon on the left, min/max/close on the right -->
    <titlebar>
      <layout>icon:iconify,max,close</layout>
    </titlebar>
  </theme>

  <!-- Four workspaces, as in GNOME 2 -->
  <desktops number="4">
    <popupTime>500</popupTime>
  </desktops>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <keyboard>
    <!-- labwc defaults: Alt-Tab, Alt-F4, etc. -->
    <default/>

    <!-- GNOME 2 / MATE shortcuts -->
    <keybind key="A-F1">
      <action name="Execute" command="mate-panel --main-menu"/>
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="mate-panel --run-dialog"/>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="mate-terminal"/>
    </keybind>
    <keybind key="C-A-l">
      <action name="Execute" command="gtklock"/>
    </keybind>

    <!-- Workspaces -->
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" wrap="no"/>
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" wrap="no"/>
    </keybind>
    <keybind key="C-A-S-Left">
      <action name="SendToDesktop" to="left" wrap="no"/>
    </keybind>
    <keybind key="C-A-S-Right">
      <action name="SendToDesktop" to="right" wrap="no"/>
    </keybind>

    <!-- Screenshots: whole screen, and Shift for a selected area -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim ~/Pictures/Screenshot-$(date +%F-%H%M%S).png'"/>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; ~/Pictures/Screenshot-$(date +%F-%H%M%S).png'"/>
    </keybind>
  </keyboard>

</labwc_config>
