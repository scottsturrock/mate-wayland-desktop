+/* A touchpad sends no wheel clicks, only smooth scroll events: a stream of
+ * small distances. Add them up and return one volume step for each whole unit
+ * travelled. A mouse wheel may send a smooth event as well as its click; the
+ * click is the one that counts. */
+static gboolean
+smooth_scroll_volume (GvcStreamAppletIcon *icon,
+                      GdkEventScroll      *event)
+{
+        GdkDevice *device;
+        gdouble    dx = 0.0;
+        gdouble    dy = 0.0;
+        gboolean   handled = FALSE;
+
+        if (gdk_event_is_scroll_stop_event ((GdkEvent *) event)) {
+                icon->priv->smooth_scroll = 0.0;
+                return TRUE;
+        }
+        if (event->time == icon->priv->wheel_time)
+                return TRUE;
+        if (!gdk_event_get_scroll_deltas ((GdkEvent *) event, &dx, &dy) || dy == 0.0)
+                return FALSE;
+
+        device = gdk_event_get_source_device ((GdkEvent *) event);
+        if (device != NULL && gdk_device_get_source (device) == GDK_SOURCE_MOUSE) {
+                /* A wheel whose click was not delivered: one step a notch. */
+                return scroll_volume (icon, dy < 0.0 ? GDK_SCROLL_UP : GDK_SCROLL_DOWN);
+        }
+
+        if ((dy < 0.0) != (icon->priv->smooth_scroll < 0.0))
+                icon->priv->smooth_scroll = 0.0;
+        icon->priv->smooth_scroll += dy;
+
+        while (icon->priv->smooth_scroll <= -1.0) {
+                icon->priv->smooth_scroll += 1.0;
+                handled |= scroll_volume (icon, GDK_SCROLL_UP);
+        }
+        while (icon->priv->smooth_scroll >= 1.0) {
+                icon->priv->smooth_scroll -= 1.0;
+                handled |= scroll_volume (icon, GDK_SCROLL_DOWN);
+        }
+        return handled;
+}
