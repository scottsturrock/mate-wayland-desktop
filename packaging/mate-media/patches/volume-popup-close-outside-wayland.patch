+#if defined(ENABLE_WAYLAND)
+static void popdown_dock (GvcStreamAppletIcon *icon);
+
+/* A layer-shell surface receives no pointer events outside itself, and the
+ * seat grab that closes the dock on an outside click on X11 does nothing for
+ * it, so on Wayland the dock stayed open until its icon was clicked again.
+ * While the dock is open, put an invisible surface over every monitor, under
+ * the dock; a click on one of them closes the dock. */
+static void
+remove_click_catchers (GvcStreamAppletIcon *icon)
+{
+        g_list_free_full (icon->priv->click_catchers, (GDestroyNotify) gtk_widget_destroy);
+        icon->priv->click_catchers = NULL;
+}
+
+static gboolean
+on_click_catcher_button_press (GtkWidget           *widget,
+                               GdkEventButton      *event,
+                               GvcStreamAppletIcon *icon)
+{
+        popdown_dock (icon);
+        return TRUE;
+}
+
+static gboolean
+on_click_catcher_draw (GtkWidget *widget,
+                       cairo_t   *cr,
+                       gpointer   user_data)
+{
+        cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+        cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 0.0);
+        cairo_paint (cr);
+        return TRUE;
+}
+
+static void
+add_click_catchers (GvcStreamAppletIcon *icon,
+                    GdkDisplay          *display)
+{
+        int i;
+
+        remove_click_catchers (icon);
+
+        for (i = 0; i < gdk_display_get_n_monitors (display); i++) {
+                GtkWidget *catcher;
+                GdkVisual *visual;
+
+                catcher = gtk_window_new (GTK_WINDOW_POPUP);
+                gtk_window_set_decorated (GTK_WINDOW (catcher), FALSE);
+                gtk_layer_init_for_window (GTK_WINDOW (catcher));
+                gtk_layer_set_namespace (GTK_WINDOW (catcher), "volume-control-dismiss");
+                gtk_layer_set_monitor (GTK_WINDOW (catcher), gdk_display_get_monitor (display, i));
+                gtk_layer_set_layer (GTK_WINDOW (catcher), GTK_LAYER_SHELL_LAYER_TOP);
+                gtk_layer_set_anchor (GTK_WINDOW (catcher), GTK_LAYER_SHELL_EDGE_TOP, TRUE);
+                gtk_layer_set_anchor (GTK_WINDOW (catcher), GTK_LAYER_SHELL_EDGE_BOTTOM, TRUE);
+                gtk_layer_set_anchor (GTK_WINDOW (catcher), GTK_LAYER_SHELL_EDGE_LEFT, TRUE);
+                gtk_layer_set_anchor (GTK_WINDOW (catcher), GTK_LAYER_SHELL_EDGE_RIGHT, TRUE);
+                /* Cover the panels too: do not make room for them. */
+                gtk_layer_set_exclusive_zone (GTK_WINDOW (catcher), -1);
+
+                visual = gdk_screen_get_rgba_visual (gtk_widget_get_screen (catcher));
+                if (visual != NULL)
+                        gtk_widget_set_visual (catcher, visual);
+                gtk_widget_set_app_paintable (catcher, TRUE);
+                gtk_widget_add_events (catcher, GDK_BUTTON_PRESS_MASK);
+                g_signal_connect (catcher, "draw",
+                                  G_CALLBACK (on_click_catcher_draw), NULL);
+                g_signal_connect (catcher, "button-press-event",
+                                  G_CALLBACK (on_click_catcher_button_press), icon);
+
+                gtk_widget_show (catcher);
+                icon->priv->click_catchers = g_list_prepend (icon->priv->click_catchers, catcher);
+        }
+}
+#endif /* wayland support */
